{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Temporal aggregations based on calendar hierarchies",
  "type": "object",
  "properties": {
    "data": {
      "$ref": "https://raw.githubusercontent.com/GeoLabs/bblocks-openeo/undefined/build/annotated/openeo/types/datacube/schema.json"
    },
    "period": {
      "type": "string",
      "enum": [
        "hour",
        "day",
        "week",
        "dekad",
        "month",
        "season",
        "tropical-season",
        "year",
        "decade",
        "decade-ad"
      ]
    },
    "reducer": {
      "$ref": "https://raw.githubusercontent.com/GeoLabs/bblocks-openeo/undefined/build/annotated/openeo/types/process-graph/schema.json"
    },
    "dimension": {
      "type": [
        "string",
        "null"
      ]
    },
    "context": {
      "description": "Any data type."
    }
  },
  "required": [
    "data",
    "period",
    "reducer"
  ]
}