{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Concatenate elements to a single text",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "separator": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    }
  },
  "required": [
    "data"
  ]
}