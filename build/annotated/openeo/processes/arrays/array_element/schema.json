{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Get an element from an array",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "description": "Any data type is allowed."
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "label": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "return_nodata": {
      "type": "boolean"
    }
  },
  "required": [
    "data"
  ]
}