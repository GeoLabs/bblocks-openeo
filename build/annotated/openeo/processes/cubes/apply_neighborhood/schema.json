{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Apply a process to pixels in a n-dimensional neighborhood",
  "type": "object",
  "properties": {
    "data": {
      "$ref": "https://raw.githubusercontent.com/GeoLabs/bblocks-openeo/undefined/build/annotated/openeo/types/datacube/schema.json"
    },
    "process": {
      "$ref": "https://raw.githubusercontent.com/GeoLabs/bblocks-openeo/undefined/build/annotated/openeo/types/process-graph/schema.json"
    },
    "size": {
      "type": "array",
      "items": {
        "$ref": "https://raw.githubusercontent.com/GeoLabs/bblocks-openeo/undefined/build/annotated/openeo/types/chunk-size/schema.json"
      }
    },
    "overlap": {
      "anyOf": [
        {
          "title": "Without overlap",
          "type": "null"
        },
        {
          "title": "With overlap",
          "type": "array",
          "items": {
            "$ref": "https://raw.githubusercontent.com/GeoLabs/bblocks-openeo/undefined/build/annotated/openeo/types/chunk-size/schema.json"
          }
        }
      ]
    },
    "context": {
      "description": "Any data type."
    }
  },
  "required": [
    "data",
    "process",
    "size"
  ]
}