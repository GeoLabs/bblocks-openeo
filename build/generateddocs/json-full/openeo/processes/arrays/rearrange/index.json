          "language": "json",
          "url": "https://raw.githubusercontent.com/GeoLabs/bblocks-openeo/undefined/build/tests/openeo/processes/arrays/rearrange/example_2_1.json",
          "sizeBytes": 77,
          "code": "{\n  \"data\": [\n    5,\n    4,\n    3,\n    2\n  ],\n  \"order\": [\n    1,\n    3\n  ]\n}"
