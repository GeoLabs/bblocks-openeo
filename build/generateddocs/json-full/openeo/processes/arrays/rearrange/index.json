          "code": "{\n  \"data\": [\n    5,\n    4,\n    3\n  ],\n  \"order\": [\n    2,\n    1,\n    0\n  ]\n}"
        }
      ]
    },
    {
      "title": "Remove two elements",
      "content": "Calling `rearrange` with these arguments returns `[4, 2]`.",
      "snippets": [
